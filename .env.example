# Copy to .env and adjust. Everything here is optional.

# Network: "devnet" (default) or "mainnet"
VITE_SOLANA_CLUSTER=devnet

# Private RPC endpoint (recommended; the public endpoints rate-limit quickly)
# VITE_SOLANA_RPC=https://your-rpc-provider.example/your-key

# Authority revocation fees (Authorities / My Tokens page)
# Price per authority in SOL. Default 0.1
VITE_AUTHORITY_FEE_SOL=0.1
# BALNEX treasury wallet that receives fees. No default: leave empty until you have one.
# For Devnet testing, use any Devnet address you control.
VITE_TREASURY_WALLET=
# Fees are blocked on Mainnet unless this is "true"
VITE_ENABLE_MAINNET_FEES=false

# Trending (all optional; defaults shown). Thresholds and weights for the activity ranking.
# VITE_TRENDING_REFRESH_MS=45000
# VITE_TRENDING_MIN_LIQUIDITY_USD=5000
# VITE_TRENDING_MIN_VOLUME_24H_USD=5000
# VITE_TRENDING_MIN_TXNS_24H=50
# VITE_TRENDING_MIN_PAIR_AGE_MIN=30
# VITE_TRENDING_REQUIRE_TWO_SIDED=true
# VITE_TRENDING_W_VOLUME=0.3  VITE_TRENDING_W_TXNS=0.25  VITE_TRENDING_W_LIQUIDITY=0.2  VITE_TRENDING_W_MOMENTUM=0.15  VITE_TRENDING_W_FRESHNESS=0.1
